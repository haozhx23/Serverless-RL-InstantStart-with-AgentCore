      "default": "dpo",
      "variants": [
        {
          "id": "dpo",
          "label": "DPO",
          "file": "preference_loss.py",
          "summary": "-log sigmoid(beta * margin): push the margin wider, ever more gently.",
          "watch": "The loss falls fast, then flattens as the sigmoid saturates.",
          "short": "DPO"
        },
        {
          "id": "ipo",
          "label": "IPO",
          "file": "variants/preference_ipo.py",
          "summary": "(margin - 1/(2 beta))^2: pull the margin to a fixed target.",
          "watch": "The margin stops growing near its target instead of running away.",
          "short": "IPO"
        },
        {
          "id": "hinge",
          "label": "Hinge (SLiC)",
          "file": "variants/preference_hinge.py",
          "summary": "max(0, 1 - beta * margin): full push until a pair is won, then none.",
          "watch": "Every pair pushes equally until its scaled margin passes 1.",
          "short": "hinge"
        }
      ]
    },
